{
  // Point the C/C++ extension at compile_commands.json generated by
  // CMake for the acrylic-glass effect. Resolves Qt AUTOMOC-generated
  // headers (main.moc, *_autogen/include/*) so IntelliSense stops
  // complaining about "cannot open source file" on moc-included files.
  //
  // Regenerate after editing CMakeLists or pulling new deps:
  //   sudo ./install --only --acrylic-glass
  // or directly:
  //   cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON build/kwin-effects/acrylic-glass
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/kwin-effects/acrylic-glass/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",

  // Fallback include paths for files outside CMake's compile DB
  // (e.g. headers viewed standalone). The real source-of-truth is
  // compile_commands.json above.
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/src/offline/kwin-effects/acrylic-glass/src",
    "${workspaceFolder}/build/kwin-effects/acrylic-glass/src",
    "${workspaceFolder}/build/kwin-effects/acrylic-glass/src/liquidglass_autogen/include",
    "${workspaceFolder}/build/kwin-effects/acrylic-glass/src/kcm/kwin_liquidglass_config_autogen/include",
    "/usr/include/qt6",
    "/usr/include/qt6/QtCore",
    "/usr/include/qt6/QtGui",
    "/usr/include/qt6/QtWidgets",
    "/usr/include/qt6/QtDBus",
    "/usr/include/KF6",
    "/usr/include/KF6/KCoreAddons",
    "/usr/include/KF6/KConfigCore",
    "/usr/include/KF6/KConfigGui",
    "/usr/include/kwin",
    "/usr/include/KDecoration3"
  ]
}
