#!/bin/bash
# ./vm <distro> [--clean]
#   Boot a graphical KDE Plasma VM with this repo mounted at /repo.
#   You log in as `tester` (password `tester`) and the installer UI
#   opens automatically. Or open Konsole and run
#   `cd /repo && sudo ./install` to test the installer by hand.
#
# ./vm all [--clean]  boot every supported distro at once, each in its
#                     own window, with the installer UI pre-opened.
#                     Per-VM resources are trimmed so the fleet fits in
#                     RAM — override with VM_CPUS / VM_MEM_MIB.
# ./vm list           list supported distros
# ./vm --help         show this help
#
# Flags:
#   --clean, -c       wipe the cached overlay before booting (fresh
#                     install — picks up any cloud-init changes)
#
# Supported: cachyos arch manjaro endeavouros garuda
#            fedora nobara opensuse gentoo

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CACHE="$REPO/.vm/cache"
CI="$REPO/.vm/cloud-init"
RUN="$REPO/.vm/run"

declare -A BASE=(
    [arch]=arch.qcow2     [cachyos]=arch.qcow2  [manjaro]=arch.qcow2
    [endeavouros]=arch.qcow2 [garuda]=arch.qcow2
    [fedora]=fedora.qcow2 [nobara]=fedora.qcow2
    [opensuse]=opensuse.qcow2 [gentoo]=gentoo.qcow2
)
declare -A URL=(
    [arch.qcow2]="https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2"
    [fedora.qcow2]="https://download.fedoraproject.org/pub/fedora/linux/releases/44/Cloud/x86_64/images/Fedora-Cloud-Base-Generic-44-1.7.x86_64.qcow2"
    [opensuse.qcow2]="https://download.opensuse.org/tumbleweed/appliances/openSUSE-Tumbleweed-Minimal-VM.x86_64-Cloud.qcow2"
    [gentoo.qcow2]="https://distfiles.gentoo.org/releases/amd64/autobuilds/current-di-amd64-cloudinit/di-amd64-cloudinit-20260531T160106Z.qcow2"
)
declare -A PORT=([arch]=2221 [cachyos]=2222 [manjaro]=2223 [endeavouros]=2224 [garuda]=2225 [fedora]=2226 [nobara]=2227 [opensuse]=2228 [gentoo]=2229)

ORDER=(cachyos arch manjaro endeavouros garuda fedora nobara opensuse gentoo)

die()  { echo "✗ $*" >&2; exit 1; }
warn() { echo "⚠ $*" >&2; }
say()  { printf "→ %s\n" "$*"; }

require_tools() {
    for c in qemu-system-x86_64 qemu-img genisoimage curl; do
        command -v "$c" >/dev/null 2>&1 || die "missing tool: $c"
    done
}

ensure_base() {
    local base="$1"
    [[ -f "$CACHE/$base" ]] && return 0
    mkdir -p "$CACHE"
    say "downloading $base (first run only)"
    curl -L --fail -C - -o "$CACHE/$base.part" "${URL[$base]}"
    mv "$CACHE/$base.part" "$CACHE/$base"
}

QEMU_ARGV=()
prepare_one() {
    local distro="$1" clean="$2"
    local base port work disk cidata console ci tmp
    base="${BASE[$distro]:-}"
    [[ -n "$base" ]] || { warn "unknown distro: $distro"; return 1; }
    port="${PORT[$distro]}"

    if (( clean )) && [[ -d "$RUN/$distro" ]]; then
        say "wiping overlay $RUN/$distro"
        rm -rf "$RUN/$distro"
    fi

    ensure_base "$base" || { warn "$distro: base image download failed"; return 1; }

    work="$RUN/$distro"
    mkdir -p "$work"
    disk="$work/disk.qcow2"
    cidata="$work/cidata.iso"
    console="$work/console.log"

    [[ -f "$disk" ]] || qemu-img create -f qcow2 -F qcow2 -b "$CACHE/$base" "$disk" 60G >/dev/null

    ci="$CI/$distro.yaml"
    [[ -f "$ci" ]] || { warn "$distro: no cloud-init at $ci"; return 1; }

    tmp="$(mktemp -d)"
    cp "$ci" "$tmp/user-data"
    printf "instance-id: vm-%s-%s\nlocal-hostname: %s\n" \
        "$distro" "$(date +%s)" "$distro" > "$tmp/meta-data"
    genisoimage -output "$cidata" -volid cidata -joliet -rock \
        "$tmp/user-data" "$tmp/meta-data" 2>/dev/null
    rm -rf "$tmp"

    local fw=()
    if [[ "$distro" == "gentoo" ]]; then
        if [[ ! -f /usr/share/edk2/x64/OVMF.4m.fd ]]; then
            warn "$distro: needs OVMF firmware — install edk2-ovmf"
            return 1
        fi
        fw=(-bios /usr/share/edk2/x64/OVMF.4m.fd)
    fi

    QEMU_ARGV=(
        qemu-system-x86_64
        -name "mttkde-$distro"
        -enable-kvm -cpu host -smp "${VM_CPUS:-$DEFAULT_CPUS}" -m "${VM_MEM_MIB:-$DEFAULT_MEM}"
        -drive file="$disk",if=virtio,format=qcow2
        -drive file="$cidata",if=virtio,format=raw,readonly=on
        -boot c
        -serial file:"$console"
        -virtfs local,path="$REPO",mount_tag=repo,security_model=none,readonly=on
        -netdev user,id=net0,hostfwd=tcp::"$port"-:22
        -device virtio-net-pci,netdev=net0
        -device virtio-vga-gl,xres="${VM_XRES:-1920}",yres="${VM_YRES:-1080}"
        -display "${VM_DISPLAY:-gtk}",gl=on,show-cursor=on
        "${fw[@]}"
    )
    return 0
}

boot_all() {
    local clean="$1"
    require_tools

    local -A seen=()
    local d
    for d in "${ORDER[@]}"; do
        local b="${BASE[$d]}"
        [[ -n "${seen[$b]:-}" ]] && continue
        seen[$b]=1
        ensure_base "$b" || warn "$b: download failed (distros using it will be skipped)"
    done

    say "booting ${#ORDER[@]} VMs — each opens its own window with the installer UI"
    say "per-VM: ${VM_CPUS:-$DEFAULT_CPUS} vCPU / ${VM_MEM_MIB:-$DEFAULT_MEM} MiB (override VM_CPUS / VM_MEM_MIB)"

    local pids=() started=0
    for d in "${ORDER[@]}"; do
        if ! prepare_one "$d" "$clean"; then
            warn "skipping $d"
            continue
        fi
        say "  $d → ssh -p ${PORT[$d]} tester@127.0.0.1 (password tester)"
        "${QEMU_ARGV[@]}" &
        pids+=("$!")
        started=$((started + 1))
        sleep 2
    done

    (( started > 0 )) || die "no VMs could be started"
    say "$started VM(s) running. Close a window to stop that VM; Ctrl-C here stops all."

    trap 'echo; say "stopping all VMs"; kill "${pids[@]}" 2>/dev/null || true' INT TERM
    wait
}

boot_one() {
    local distro="$1" clean="$2"
    require_tools
    prepare_one "$distro" "$clean" || die "cannot boot $distro"
    say "booting $distro VM (ssh: ssh -p ${PORT[$distro]} tester@127.0.0.1, password tester)"
    say "the installer UI opens automatically; or run cd /repo && sudo ./install"
    exec "${QEMU_ARGV[@]}"
}

case "${1:-}" in
    ""|-h|--help) sed -n '2,20p' "$0" | sed 's|^#||; s|^ ||'; exit 0 ;;
    list) printf '%s\n' "${ORDER[@]}"; exit 0 ;;
esac

target="$1"; shift || true
clean=0
for a in "$@"; do
    case "$a" in
        --clean|-c) clean=1 ;;
        *) die "unknown flag: $a (try ./vm --help)" ;;
    esac
done

if [[ "$target" == "all" ]]; then
    DEFAULT_CPUS=2
    DEFAULT_MEM=4096
    boot_all "$clean"
else
    DEFAULT_CPUS=4
    DEFAULT_MEM=6144
    boot_one "$target" "$clean"
fi
