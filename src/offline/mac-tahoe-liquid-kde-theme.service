[Unit]
Description=MacTahoe Liquid KDE — apply auto light/dark theme
# Prefer an established desktop when login and timer jobs are queued together.
After=plasma-plasmashell.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/mac-tahoe-theme-switch scheduled
# Retry when the scheduled job is waiting for a display or clock sync.
RestartForceExitStatus=75
RestartSec=15s
TimeoutStartSec=3min

[Install]
WantedBy=plasma-plasmashell.service
