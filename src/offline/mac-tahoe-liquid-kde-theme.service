[Unit]
Description=MacTahoe Liquid KDE — apply auto light/dark theme
# Run after the desktop is up — not at boot, not at the login screen.
# plasma-plasmashell.service comes up once the user has logged in and
# plasmashell is reachable. The script itself sleeps 10s before each
# plasma-apply-lookandfeel attempt and retries up to 3 times, so no
# ExecStartPre wait is needed here.
After=plasma-plasmashell.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/mac-tahoe-theme-switch auto

[Install]
WantedBy=plasma-plasmashell.service
