msgid "About This Computer"
msgstr "इस कंप्यूटर के बारे में"

msgid "Adaptive Contrast"
msgstr "अनुकूलनात्मक विपरीत"

msgid "Add fine grain to the glass texture. 0 disables grain."
msgstr "ग्लास बनावट में बारीक अनाज जोड़ें। 0 अनाज को निष्क्रिय करता है।"

msgid "Adjust color intensity. 0 gives grayscale; 1 keeps the original colors."
msgstr "रंग तीव्रता समायोजित करें. 0 ग्रे स्केल देता है; 1 मूल रंगों को बनाए रखता है।"

msgid "Adjust the difference between light and dark tones. 1 keeps the original contrast."
msgstr "प्रकाश और अंधेरे स्वरों के बीच अंतर को समायोजित करें। 1 मूल विपरीत बनाए रखता है।"

msgid "All except matching windows"
msgstr "सभी को छोड़कर जोड़ी खिड़कियों"

msgid "Amount of blurred backdrop in the centre. 1 keeps full blur; lower values reveal more sharp background."
msgstr "केंद्र में धुंधली पृष्ठभूमि की मात्रा। 1 पूर्ण धुंधलापन बनाए रखता है; निम्न मानों से अधिक तेज पृष्ठभूमि दिखाई देती है।"

msgid "Appearance"
msgstr "दिखावट"

msgid "Application windows"
msgstr "अनुप्रयोग विंडो"

msgid "Apps + Clipboard"
msgstr "ऐप्स + क्लिपबोर्ड"

msgid "Background gradient"
msgstr "पृष्ठभूमि ग्रेडिएंट"

msgid "Background transparency only. 0% is opaque; 100% is transparent. Text, borders and icons stay intact."
msgstr "केवल पृष्ठभूमि पारदर्शिता. 0% अस्पष्ट है; 100% पारदर्शी है। पाठ, सीमाएँ और आइकन बरकरार रहते हैं।"

msgid "Bend the background near the glass edge. 0 disables distortion."
msgstr "ग्लास किनारे के पास पृष्ठभूमि को झुकाएं। 0 विकृति को अक्षम करता है।"

msgid "Blur coverage"
msgstr "धुंधली कवरेज"

msgid "Blur strength"
msgstr "धुंधल शक्ति"

msgid "Blur window decorations"
msgstr "अंधा खिड़की सजावट"

msgid "Bottom color"
msgstr "नीचे का रंग"

msgid "Bottom color in dark mode."
msgstr "अंधेरे मोड में नीचे का रंग।"

msgid "Bottom color in light mode."
msgstr "प्रकाश मोड में नीचे का रंग।"

msgid "Bottom tint strength"
msgstr "निचली रंग शक्ति"

msgid "Bottom tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "दोनों मोड के लिए नीचे रंग शक्ति. 0 इस स्टॉप पर ग्लास को रंगहीन छोड़ देता है।"

msgid "Brightness"
msgstr "चमक"

msgid "Center color"
msgstr "मध्य रंग"

msgid "Center color in dark mode."
msgstr "अंधेरे मोड में केंद्र रंग।"

msgid "Center color in light mode."
msgstr "प्रकाश मोड में केंद्र रंग।"

msgid "Center position"
msgstr "केंद्र स्थिति"

msgid "Center tint strength"
msgstr "केंद्र रंग शक्ति"

msgid "Center tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "दोनों मोड के लिए केंद्र रंग शक्ति. 0 इस स्टॉप पर ग्लास को रंगहीन छोड़ देता है।"

msgid "Color separation (px)"
msgstr "रंग विभाजन (px)"

msgid "Colors follow each window's light or dark appearance automatically."
msgstr "रंग प्रत्येक खिड़की के प्रकाश या अंधेरे रूप का स्वचालित रूप से अनुसरण करते हैं।"

msgid "Component"
msgstr "घटक"

msgid "Contrast"
msgstr "कंट्रास्ट"

msgid "Control Center"
msgstr "नियंत्रण केंद्र"

msgid "Copy values"
msgstr "कॉपी मान"

msgid "Corner Radius (px)"
msgstr "कोण त्रिज्या (px)"

msgid "Corners"
msgstr "कोने"

msgid "Could not apply background transparency: %1"
msgstr "पृष्ठभूमि पारदर्शिता लागू नहीं कर सकाः %1"

msgid "Dark mode"
msgstr "अंधेरे मोड"

msgid "Dock"
msgstr "Dock"

msgid "Dock/Launcher"
msgstr "Dock/Launcher"

msgid "Enable gradient"
msgstr "ग्रेडिएंट सक्षम करें"

msgid "Extend background blur to translucent window frames and title bars."
msgstr "पृष्ठभूमि धुंधलापन को पारदर्शी खिड़की फ्रेम और शीर्षक बारों तक बढ़ाएं।"

msgid "Finder"
msgstr "Finder"

msgid "Fine tuning"
msgstr "ठीक से ट्यूनिंग"

msgid "Force Blur List"
msgstr "बल धुंध सूची"

msgid "Glass"
msgstr "ग्लास"

msgid "Grain"
msgstr "अनाज"

msgid "Highlight strength"
msgstr "प्रकाश शक्ति"

msgid "Highlight width (px)"
msgstr "हाइलाइट चौड़ाई (px)"

msgid "Intensity of the edge highlight. 0 disables it."
msgstr "किनारे हाइलाइट की तीव्रता. 0 इसे अक्षम करता है।"

msgid "Light mode"
msgstr "प्रकाश मोड"

msgid "Lighten or darken the glass background. 1 keeps the original brightness."
msgstr "ग्लास पृष्ठभूमि को हल्का या अंधा कर दें। 1 मूल चमक बनाए रखता है।"

msgid "Match Mode"
msgstr "मैच मोड"

msgid "Menus / Shell"
msgstr "मेनू / शेल"

msgid "One window class or resource name per line."
msgstr "प्रति पंक्ति एक विंडो वर्ग या संसाधन नाम।"

msgid "Only matching windows"
msgstr "केवल मिलान खिड़कियां"

msgid "Optics"
msgstr "ऑप्टिक्स"

msgid "Paste values"
msgstr "पेस्ट मान"

msgid "Plasma widget popups"
msgstr "Plasma विगेट पॉपअप"

msgid "Popups"
msgstr "पपअप"

msgid "Position from top (0) to bottom (1). 0.5 is halfway down the surface."
msgstr "ऊपर से नीचे तक की स्थिति (0) (1) 0.5 सतह के बीच में है।"

msgid "Preset"
msgstr "पूर्व निर्धारित"

msgid "Refraction"
msgstr "प्रतिरोध"

msgid "Refraction width (px)"
msgstr "विघटन चौड़ाई (px)"

msgid "Restore this preset"
msgstr "इस पूर्वनिर्धारित को पुनर्स्थापित करें"

msgid "Round maximized windows"
msgstr "गोल अधिकतम खिड़कियां"

msgid "Saturation"
msgstr "संतृप्ति"

msgid "Search capsule"
msgstr "खोज कैप्सूल"

msgid "Separate red, green and blue near the glass edge. 0 disables color fringes."
msgstr "ग्लास के किनारे के पास लाल, हरे और नीले रंग को अलग करें। 0 रंग किनारों को निष्क्रिय करता है।"

msgid "Slightly adjust text when it blends into the background."
msgstr "पाठ को पृष्ठभूमि में मिलाकर थोड़ा सा समायोजित करें।"

msgid "Soften the background behind glass. 0 leaves the background sharp."
msgstr "ग्लास के पीछे पृष्ठभूमि को नरम करें। 0 पृष्ठभूमि को तेज छोड़ देता है।"

msgid "Surface"
msgstr "सतह"

msgid "Tint strength"
msgstr "टिन ताकत"

msgid "Tooltips, menus, dialogs and applet popups."
msgstr "उपकरण युक्तियाँ, मेनू, संवाद और एपलेट पॉपअप।"

msgid "Top color"
msgstr "शीर्ष रंग"

msgid "Top color in dark mode."
msgstr "अंधेरे मोड में शीर्ष रंग।"

msgid "Top color in light mode."
msgstr "प्रकाश मोड में शीर्ष रंग।"

msgid "Top panel"
msgstr "शीर्ष पैनल"

msgid "Top tint strength"
msgstr "उच्चतम रंग शक्ति"

msgid "Top tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "दोनों मोड के लिए उच्चतम रंग शक्ति। 0 इस स्टॉप पर ग्लास को रंगहीन छोड़ देता है।"

msgid "Transparency SVG (Dark)"
msgstr "पारदर्शिता SVG (अंधेरा)"

msgid "Transparency SVG (Light)"
msgstr "पारदर्शिता SVG (प्रकाश)"

msgid "Width of the bright rim along the glass edge."
msgstr "ग्लास किनारे के साथ उज्ज्वल रिम की चौड़ाई।"

msgid "Width of the edge band where refraction and color separation appear."
msgstr "किनारे के बैंड की चौड़ाई जहां फ्रैक्शन और रंग पृथक्करण दिखाई देते हैं।"

msgid "Window Rules"
msgstr "खिड़की नियम"

msgid "Windows"
msgstr "विंडोज़"

msgid "examples:\norg.kde.dolphin\nfirefox"
msgstr "उदाहरण:\norg.kde.dolphin\nफ़ायरफ़ॉक्स"
