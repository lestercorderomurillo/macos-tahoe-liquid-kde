msgstr "構成要素"

msgid "Contrast"
msgstr "コントラスト"

msgid "Control Center"
msgstr "コントロールセンター"

msgid "Copy values"
msgstr "コピー値"

msgid "Corner Radius (px)"
msgstr "角半径 (px)"

msgid "Corners"
msgstr "角"

msgid "Could not apply background transparency: %1"
msgstr "背景透明性適用できない: %1"

msgid "Dark mode"
msgstr "ダークモード"

msgid "Dock"
msgstr "Dock"

