msgid "About This Computer"
msgstr "关于本机"

msgid "Adaptive Contrast"
msgstr "适应性对比"

msgid "Adaptive Contrast presets"
msgstr "自适应对比度预设"

msgid "Adaptive Contrast presets…"
msgstr "自适应对比度预设…"

msgid "Add fine grain to the glass texture. 0 disables grain."
msgstr "为玻璃纹理添加细微颗粒。设为 0 可关闭颗粒效果。"

msgid "Adjust color intensity. 0 gives grayscale; 1 keeps the original colors."
msgstr "调整颜色强度. 0 给出灰度; 1 保持原始颜色."

msgid "Adjust the difference between light and dark tones. 1 keeps the original contrast."
msgstr "调整光和暗色之间的差异. 1保持原始的对比度."

msgid "All except matching windows"
msgstr "除了相匹配的窗户外"

msgid "Amount of blurred backdrop in the centre. 1 keeps full blur; lower values reveal more sharp background."
msgstr "控制中心区域的背景模糊程度。设为 1 时完全模糊，值越小，背景越清晰。"

msgid "Appearance"
msgstr "外观"

msgid "Application windows"
msgstr "应用程序窗口"

msgid "Apps + Clipboard"
msgstr "应用程序+剪辑板"

msgid "Background gradient"
msgstr "背景梯度"

msgid "Background transparency only. 0% is opaque; 100% is transparent. Text, borders and icons stay intact."
msgstr "只有背景透明度. 0%是不透明的,100%是透明的.文字,边界和图标保持完整."

msgid "Bend the background near the glass edge. 0 disables distortion."
msgstr "使玻璃边缘附近的背景产生折射。设为 0 可关闭变形效果。"

msgid "Blur coverage"
msgstr "模糊的覆盖"

msgid "Blur strength"
msgstr "模糊强度"

msgid "Blur window decorations"
msgstr "模糊的窗户装饰"

msgid "Bottom color"
msgstr "下面的颜色"

msgid "Bottom color in dark mode."
msgstr "底部颜色在黑暗模式下."

msgid "Bottom color in light mode."
msgstr "底部颜色在光模式下."

msgid "Bottom tint strength"
msgstr "底部色强度"

msgid "Bottom tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "两种模式的下面色强度. 0 在此停止,玻璃没有染色."

msgid "Brightness"
msgstr "Brightness"

msgid "Center color"
msgstr "中央颜色"

msgid "Center color in dark mode."
msgstr "黑色模式中部."

msgid "Center color in light mode."
