msgid "About This Computer"
msgstr "Об этом компьютере"

msgid "Adaptive Contrast"
msgstr "Адаптивный контраст"

msgid "Add fine grain to the glass texture. 0 disables grain."
msgstr "Мелкое зерно в текстуре стекла. 0 отключает зерно."

msgid "Adjust color intensity. 0 gives grayscale; 1 keeps the original colors."
msgstr "Насыщенность цветов. 0 даёт оттенки серого; 1 сохраняет исходные цвета."

msgid "Adjust the difference between light and dark tones. 1 keeps the original contrast."
msgstr "Разница между светлыми и тёмными тонами. 1 сохраняет исходный контраст."

msgid "All except matching windows"
msgstr "Все, кроме подходящих окон"

msgid "Amount of blurred backdrop in the centre. 1 keeps full blur; lower values reveal more sharp background."
msgstr "Доля размытого фона в центре. 1 сохраняет полное размытие; меньшие значения открывают больше чёткого фона."

msgid "Appearance"
msgstr "Внешний вид"

msgid "Application windows"
msgstr "Окна приложений"

msgid "Apps + Clipboard"
msgstr "Приложения + буфер обмена"

msgid "Background gradient"
msgstr "Градиент фона"

msgid "Background transparency only. 0% is opaque; 100% is transparent. Text, borders and icons stay intact."
msgstr "Только прозрачность фона. 0% — непрозрачный; 100% — прозрачный. Текст, рамки и значки не меняются."

msgid "Bend the background near the glass edge. 0 disables distortion."
msgstr "Искривлять фон у края стекла. 0 отключает искажение."

msgid "Blur coverage"
msgstr "Охват размытия"

msgid "Blur strength"
msgstr "Сила размытия"

msgid "Blur window decorations"
msgstr "Размывать оформление окон"

msgid "Bottom color"
msgstr "Нижний цвет"

msgid "Bottom color in dark mode."
msgstr "Нижний цвет в тёмном режиме."

msgid "Bottom color in light mode."
msgstr "Нижний цвет в светлом режиме."

msgid "Bottom tint strength"
msgstr "Сила нижнего оттенка"

msgid "Bottom tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "Сила нижнего оттенка для обоих режимов. 0 оставляет стекло без оттенка в этой точке."

msgid "Brightness"
msgstr "Яркость"

msgid "Center color"
msgstr "Цвет в центре"

msgid "Center color in dark mode."
msgstr "Цвет в центре в тёмном режиме."

msgid "Center color in light mode."
msgstr "Цвет в центре в светлом режиме."

msgid "Center position"
msgstr "Положение центра"

msgid "Center tint strength"
msgstr "Сила оттенка в центре"

msgid "Center tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "Сила оттенка в центре для обоих режимов. 0 оставляет стекло без оттенка в этой точке."

msgid "Color separation (px)"
msgstr "Разделение цветов (пикс.)"

msgid "Colors follow each window's light or dark appearance automatically."
msgstr "Цвета автоматически следуют светлому или тёмному оформлению каждого окна."

msgid "Component"
msgstr "Компонент"

msgid "Contrast"
msgstr "Контраст"

msgid "Control Center"
msgstr "Пункт управления"

msgid "Copy values"
msgstr "Копировать значения"

msgid "Corner Radius (px)"
msgstr "Радиус углов (пикс.)"

msgid "Corners"
msgstr "Углы"

msgid "Could not apply background transparency: %1"
msgstr "Не удалось применить прозрачность фона: %1"

msgid "Dark mode"
msgstr "Тёмный режим"

msgid "Dock"
msgstr "Dock"

msgid "Dock/Launcher"
msgstr "Dock/меню запуска"

msgid "Enable gradient"
msgstr "Включить градиент"

msgid "Extend background blur to translucent window frames and title bars."
msgstr "Размытие фона распространяется на полупрозрачные рамки и заголовки окон."

msgid "Finder"
msgstr "Finder"

msgid "Fine tuning"
msgstr "Тонкая настройка"

msgid "Force Blur List"
msgstr "Список принудительного размытия"

msgid "Glass"
msgstr "Стекло"

msgid "Grain"
msgstr "Зернистость"

msgid "Highlight strength"
msgstr "Сила блика"

msgid "Highlight width (px)"
msgstr "Ширина блика (пикс.)"

msgid "Intensity of the edge highlight. 0 disables it."
msgstr "Интенсивность подсветки края. 0 отключает её."

msgid "Light mode"
msgstr "Светлый режим"

msgid "Lighten or darken the glass background. 1 keeps the original brightness."
msgstr "Осветление или затемнение фона стекла. 1 сохраняет исходную яркость."

msgid "Match Mode"
msgstr "Режим сопоставления"

msgid "Menus / Shell"
msgstr "Меню / оболочка"

msgid "One window class or resource name per line."
msgstr "Один класс окна или имя ресурса на строку."

msgid "Only matching windows"
msgstr "Только подходящие окна"

msgid "Optics"
msgstr "Оптика"

msgid "Paste values"
msgstr "Вставить значения"

msgid "Plasma widget popups"
msgstr "Всплывающие окна виджетов Plasma"

msgid "Popups"
msgstr "Всплывающие окна"

msgid "Position from top (0) to bottom (1). 0.5 is halfway down the surface."
msgstr "Положение сверху (0) вниз (1). 0.5 — середина поверхности."

msgid "Preset"
msgstr "Пресет"

msgid "Refraction"
msgstr "Преломление"

msgid "Refraction width (px)"
msgstr "Ширина преломления (px)"

msgid "Restore this preset"
msgstr "Восстановить этот пресет"

msgid "Round maximized windows"
msgstr "Скруглять развёрнутые окна"

msgid "Saturation"
msgstr "Насыщенность"

msgid "Search capsule"
msgstr "Капсула поиска"

msgid "Separate red, green and blue near the glass edge. 0 disables color fringes."
msgstr "Разделение красного, зелёного и синего у края стекла. 0 отключает цветную кайму."

msgid "Slightly adjust text when it blends into the background."
msgstr "Слегка корректировать текст, когда он сливается с фоном."

msgid "Soften the background behind glass. 0 leaves the background sharp."
msgstr "Смягчает фон за стеклом. При 0 фон остаётся чётким."

msgid "Surface"
msgstr "Поверхность"

msgid "Tint strength"
msgstr "Сила оттенка"

msgid "Tooltips, menus, dialogs and applet popups."
msgstr "Всплывающие подсказки, меню, диалоги и окна виджетов."

msgid "Top color"
msgstr "Верхний цвет"

msgid "Top color in dark mode."
msgstr "Верхний цвет в тёмном режиме."

msgid "Top color in light mode."
msgstr "Верхний цвет в светлом режиме."

msgid "Top panel"
msgstr "Верхняя панель"

msgid "Top tint strength"
msgstr "Интенсивность верхнего оттенка"

msgid "Top tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "Сила верхнего оттенка для обоих режимов. 0 оставляет стекло без оттенка в этой точке."

msgid "Transparency SVG (Dark)"
msgstr "SVG прозрачности (тёмный)"

msgid "Transparency SVG (Light)"
msgstr "SVG прозрачности (светлый)"

msgid "Width of the bright rim along the glass edge."
msgstr "Ширина яркого ободка вдоль края стекла."

msgid "Width of the edge band where refraction and color separation appear."
msgstr "Ширина полосы у края, где видны преломление и разделение цветов."

msgid "Window Rules"
msgstr "Правила окон"

msgid "Windows"
msgstr "Окна"

