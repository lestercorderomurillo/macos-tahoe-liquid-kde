msgid "About This Computer"
msgstr "À propos de cet ordinateur"

msgid "Acrylic Glass — a complete material for your Dock, menus and windows."
msgstr "Acrylic Glass — un matériau complet pour votre Dock, vos menus et vos fenêtres."

msgid "Add fine grain to the glass texture. 0 disables grain."
msgstr "Ajoute un grain fin à la texture du verre. 0 désactive le grain."

msgid "Adjust color intensity. 0 gives grayscale; 1 keeps the original colors."
msgstr "Ajuste l’intensité des couleurs. 0 donne des niveaux de gris ; 1 conserve les couleurs d’origine."

msgid "Adjust the difference between light and dark tones. 1 keeps the original contrast."
msgstr "Ajuste la différence entre les tons clairs et sombres. 1 conserve le contraste d’origine."

msgid "All except matching windows"
msgstr "Toutes sauf les fenêtres correspondantes"

msgid "Amount of blurred backdrop in the centre. 1 keeps full blur; lower values reveal more sharp background."
msgstr "Quantité d’arrière-plan flouté au centre. 1 conserve le flou complet ; les valeurs inférieures révèlent davantage l’arrière-plan net."

msgid "Appearance"
msgstr "Apparence"

msgid "Apps + Clipboard"
msgstr "Applications + Presse-papiers"

msgid "Background gradient"
msgstr "Dégradé d’arrière-plan"

msgid "Background transparency only. 0% is opaque; 100% is transparent. Text, borders and icons stay intact."
msgstr "Transparence de l’arrière-plan uniquement. 0 % est opaque ; 100 % est transparent. Le texte, les bordures et les icônes restent intacts."

msgid "Bend the background near the glass edge. 0 disables distortion."
msgstr "Déforme l’arrière-plan près du bord du verre. 0 désactive la distorsion."

msgid "Blur coverage"
msgstr "Couverture du flou"

msgid "Blur strength"
msgstr "Intensité du flou"

msgid "Blur window decorations"
msgstr "Flouter les décorations des fenêtres"

msgid "Bottom color"
msgstr "Couleur inférieure"

msgid "Bottom color in dark mode."
msgstr "Couleur inférieure en mode sombre."

msgid "Bottom color in light mode."
msgstr "Couleur inférieure en mode clair."

msgid "Bottom tint strength"
msgstr "Intensité de la teinte inférieure"

msgid "Bottom tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "Intensité de la teinte inférieure dans les deux modes. 0 laisse le verre sans teinte à ce point."

msgid "Brightness"
msgstr "Luminosité"

msgid "Center color"
msgstr "Couleur centrale"

msgid "Center color in dark mode."
msgstr "Couleur centrale en mode sombre."

msgid "Center color in light mode."
msgstr "Couleur centrale en mode clair."

msgid "Center position"
msgstr "Position centrale"

msgid "Center tint strength"
msgstr "Intensité de la teinte centrale"

msgid "Center tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "Intensité de la teinte centrale dans les deux modes. 0 laisse le verre sans teinte à ce point."

msgid "Color separation (px)"
msgstr "Séparation des couleurs (px)"

msgid "Colors follow each window's light or dark appearance automatically."
msgstr "Les couleurs suivent automatiquement l’apparence claire ou sombre de chaque fenêtre."

msgid "Component"
msgstr "Composant"

msgid "Contrast"
msgstr "Contraste"

msgid "Control Center"
msgstr "Centre de contrôle"

msgid "Corner Radius (px)"
