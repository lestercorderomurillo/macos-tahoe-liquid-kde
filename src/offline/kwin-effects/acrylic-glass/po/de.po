msgid "Acrylic Glass — a complete material for your Dock, menus and windows."
msgstr "Acrylic Glass — ein vollständiges Material für Ihr Dock, Ihre Menüs und Fenster."

msgid "Add fine grain to the glass texture. 0 disables grain."
msgstr "Fügt der Glastextur eine feine Körnung hinzu. 0 deaktiviert die Körnung."

msgid "Adjust color intensity. 0 gives grayscale; 1 keeps the original colors."
msgstr "Passt die Farbintensität an. 0 ergibt Graustufen; 1 behält die ursprünglichen Farben bei."

msgid "Adjust the difference between light and dark tones. 1 keeps the original contrast."
msgstr "Passt den Unterschied zwischen hellen und dunklen Tönen an. 1 behält den ursprünglichen Kontrast bei."

msgid "All except matching windows"
msgstr "Alle außer passenden Fenstern"

msgid "Appearance"
msgstr "Erscheinungsbild"

msgid "Background gradient"
msgstr "Hintergrundverlauf"

msgid "Bend the background near the glass edge. 0 disables distortion."
msgstr "Verzerrt den Hintergrund am Glasrand. 0 deaktiviert die Verzerrung."

msgid "Blur strength"
msgstr "Unschärfestärke"

msgid "Blur window decorations"
msgstr "Fensterdekorationen weichzeichnen"

msgid "Bottom color"
msgstr "Untere Farbe"

msgid "Bottom color in dark mode."
msgstr "Untere Farbe im dunklen Modus."

msgid "Bottom color in light mode."
msgstr "Untere Farbe im hellen Modus."

msgid "Bottom tint strength"
msgstr "Untere Tönungsstärke"

msgid "Bottom tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "Untere Tönungsstärke für beide Modi. Bei 0 bleibt das Glas an diesem Punkt ungetönt."

msgid "Brightness"
msgstr "Helligkeit"

msgid "Center color"
msgstr "Mittlere Farbe"

msgid "Center color in dark mode."
msgstr "Mittlere Farbe im dunklen Modus."

msgid "Center color in light mode."
msgstr "Mittlere Farbe im hellen Modus."

msgid "Center position"
msgstr "Mittlere Position"

msgid "Center tint strength"
msgstr "Mittlere Tönungsstärke"

msgid "Center tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "Mittlere Tönungsstärke für beide Modi. Bei 0 bleibt das Glas an diesem Punkt ungetönt."

msgid "Color separation (px)"
msgstr "Farbaufspaltung (px)"

msgid "Colors follow each window's light or dark appearance automatically."
msgstr "Die Farben folgen automatisch dem hellen oder dunklen Erscheinungsbild jedes Fensters."

msgid "Contrast"
msgstr "Kontrast"

msgid "Corner Radius (px)"
msgstr "Eckenradius (px)"

msgid "Corners"
msgstr "Ecken"

msgid "Dark mode"
msgstr "Dunkler Modus"

msgid "Dock/Launcher"
msgstr "Dock/Anwendungsstarter"

msgid "Enable gradient"
msgstr "Farbverlauf aktivieren"

msgid "Extend background blur to translucent window frames and title bars."
msgstr "Erweitert die Hintergrundunschärfe auf durchscheinende Fensterrahmen und Titelleisten."

msgid "Fine tuning"
msgstr "Feinabstimmung"

msgid "Force Blur List"
msgstr "Liste für erzwungene Unschärfe"

msgid "Glass"
msgstr "Glas"

msgid "Golden Gate (Official)"
msgstr "Golden Gate (Official)"

msgid "Grain"
msgstr "Körnung"

msgid "Highlight strength"
msgstr "Glanzstärke"

msgid "Highlight width (px)"
msgstr "Glanzbreite (px)"

msgid "Intensity of the edge highlight. 0 disables it."
msgstr "Stärke des Glanzlichts am Rand. 0 deaktiviert es."

msgid "Light mode"
msgstr "Heller Modus"

msgid "Lighten or darken the glass background. 1 keeps the original brightness."
msgstr "Hellt den Glashintergrund auf oder dunkelt ihn ab. 1 behält die ursprüngliche Helligkeit bei."

msgid "Match Mode"
msgstr "Abgleichmodus"

msgid "One window class or resource name per line."
msgstr "Eine Fensterklasse oder ein Ressourcenname pro Zeile."

msgid "Only matching windows"
msgstr "Nur passende Fenster"

msgid "Optics"
msgstr "Optik"

msgid "Popups"
msgstr "Einblendfenster"

msgid "Position from top (0) to bottom (1). 0.5 is halfway down the surface."
msgstr "Position von oben (0) nach unten (1). 0.5 liegt auf halber Höhe der Oberfläche."

msgid "Preset"
msgstr "Vorgabe"

msgid "Refraction"
msgstr "Lichtbrechung"

msgid "Refraction width (px)"
msgstr "Brechungsbreite (px)"

msgid "Restore this preset"
msgstr "Diese Vorgabe wiederherstellen"

msgid "Round maximized windows"
msgstr "Maximierte Fenster abrunden"

msgid "Saturation"
msgstr "Sättigung"

msgid "Separate red, green and blue near the glass edge. 0 disables color fringes."
msgstr "Trennt Rot, Grün und Blau am Glasrand. 0 deaktiviert Farbsäume."

msgid "Soften the background behind glass. 0 leaves the background sharp."
msgstr "Zeichnet den Hintergrund hinter dem Glas weich. Bei 0 bleibt der Hintergrund scharf."

msgid "Surface"
msgstr "Oberfläche"

msgid "Tahoe (Clear)"
msgstr "Tahoe (Klar)"

msgid "Tahoe (Frosted)"
msgstr "Tahoe (Mattiert)"

msgid "Tint strength"
msgstr "Tönungsstärke"

msgid "Tooltips, menus, dialogs and applet popups."
msgstr "Kurzinfos, Menüs, Dialoge und Plasmoid-Einblendfenster."

msgid "Top color"
msgstr "Obere Farbe"

msgid "Top color in dark mode."
msgstr "Obere Farbe im dunklen Modus."

msgid "Top color in light mode."
msgstr "Obere Farbe im hellen Modus."

msgid "Top tint strength"
msgstr "Obere Tönungsstärke"

msgid "Top tint strength for both modes. 0 leaves the glass untinted at this stop."
msgstr "Obere Tönungsstärke für beide Modi. Bei 0 bleibt das Glas an diesem Punkt ungetönt."

msgid "Width of the bright rim along the glass edge."
msgstr "Breite des hellen Saums am Glasrand."

msgid "Width of the edge band where refraction and color separation appear."
msgstr "Breite des Randbereichs, in dem Lichtbrechung und Farbaufspaltung erscheinen."

msgid "Window Rules"
msgstr "Fensterregeln"

msgid "Windows"
msgstr "Fenster"

msgid "examples:\norg.kde.dolphin\nfirefox"
msgstr "Beispiele:\\norg.kde.dolphin\\nfirefox"
