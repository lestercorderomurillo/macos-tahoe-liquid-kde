msgstr "As cores seguem automaticamente a aparência clara ou escura de cada janela."

msgid "Contrast"
msgstr "Contraste"

msgid "Corner Radius (px)"
msgstr "Raio dos cantos (px)"

msgid "Corners"
msgstr "Cantos"

