{
    "KPackageStructure": "Plasma/Applet",
    "KPlugin": {
        "Category": "Windows and Tasks",
        "Description": "MacTahoe Liquid KDE icons-only dock task manager with macOS-style badges",
        "EnabledByDefault": false,
        "Icon": "preferences-system-windows",
        "Id": "org.kde.mac.tahoe.liquid.icontasks",
        "License": "GPL-2.0+",
        "Name": "Icons-Only Task Manager"
    },
    "X-Plasma-API-Minimum-Version": "6.0",
    "X-Plasma-Provides": [
        "org.kde.plasma.multitasking"
    ],
    "X-Plasma-RootPath": "org.kde.mac.tahoe.liquid.taskmanager"
}
