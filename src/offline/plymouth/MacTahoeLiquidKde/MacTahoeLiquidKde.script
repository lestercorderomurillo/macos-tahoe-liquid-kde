# MacTahoe Liquid KDE — Plymouth boot splash
#
# Black background with a centered logo, scaled to ~7% of the
# screen's smaller dimension. 4K screen → ~150px logo. Matches
# macOS Tahoe's actual boot-time logo proportions. On multi-monitor setups plymouth's
# renderer mirrors the script's output to every connected display,
# so a single Sprite at the geometric centre lands centred on each
# screen automatically — DO NOT iterate Window.GetCount() and build
# per-monitor sprite arrays; the DRM renderer at real boot time
# treats those differently than the X11 plugin and ships black.
#
# Mode handling:
#   We honour Plymouth.GetMode(). Boot mode shows a thin progress
#   bar under the logo; shutdown / reboot share the same logo
#   position with the bar hidden, so the logo lands on the same
#   pixel across every mode.
#
# Plymouth callbacks we wire:
#   - SetQuitFunction          keep the logo at full opacity through
#                              handoff to the DE so we never flash a
#                              partial image during the final frame.
#   - SetBootProgressFunction  grows the white fill across the track
#                              as progress goes 0 → 1. Bound on boot
#                              only.
#   - SetDisplayMessage*       fsck warnings / LUKS hints / recovery
#                              text get stacked in the top-left.

# ── background ──────────────────────────────────────────────────────────

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# ── screen + mode ───────────────────────────────────────────────────────

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
mode     = Plymouth.GetMode();
show_progress = (mode == "boot");

# ── logo: 18% of smaller axis, centred ──────────────────────────────────

if (screen_w < screen_h)
  logo_target = Math.Int(screen_w * 0.07);
else
  logo_target = Math.Int(screen_h * 0.07);

logo_source = Image("boot.png");
logo_image  = logo_source.Scale(logo_target, logo_target);
logo        = Sprite(logo_image);
logo.SetX(Window.GetX() + screen_w / 2 - logo_image.GetWidth()  / 2);
logo.SetY(Window.GetY() + screen_h / 2 - logo_image.GetHeight() / 2);
logo.SetOpacity(1);

# ── progress bar: 20% screen-width pill below the logo (boot only) ──────

bar_w = Math.Int(screen_w * 0.10);
bar_h = Math.Int(bar_w * 0.02);
if (bar_h < 4)
  bar_h = 4;
bar_x = Window.GetX() + screen_w / 2 - bar_w / 2;
bar_y = logo.GetY() + logo_image.GetHeight() + Math.Int(screen_h * 0.08);

track_source = Image("progress_track.png");
track_image  = track_source.Scale(bar_w, bar_h);
track_sprite = Sprite(track_image);
track_sprite.SetX(bar_x);
track_sprite.SetY(bar_y);
if (!show_progress)
  track_sprite.SetOpacity(0);

fill_source = Image("progress_fill.png");
fill_sprite = Sprite();
fill_sprite.SetX(bar_x);
fill_sprite.SetY(bar_y);

# ── callbacks ───────────────────────────────────────────────────────────

fun on_quit()
{
  logo.SetOpacity(1);
}
Plymouth.SetQuitFunction(on_quit);

fun on_boot_progress(duration, progress)
{
  if (progress < 0)
    progress = 0;
  if (progress > 1)
    progress = 1;
  fill_image = fill_source.Scale(Math.Int(bar_w * progress), bar_h);
  fill_sprite.SetImage(fill_image);
}
if (show_progress)
  Plymouth.SetBootProgressFunction(on_boot_progress);

# Console-style messages from the boot process get stacked in the
# top-left so a stalled boot is still diagnosable without exiting
# the splash. White text, transparent background, 10px insets.

message_y       = 10;
message_sprites = [];
message_count   = 0;

fun on_show_message(text)
{
  rendered = Image.Text(text, 1, 1, 1);
  sprite   = Sprite(rendered);
  sprite.SetPosition(10, message_y, 10000);
  sprite.text = text;
  message_sprites[message_count] = sprite;
  message_count++;
  message_y += rendered.GetHeight();
}
Plymouth.SetDisplayMessageFunction(on_show_message);

fun on_hide_message(text)
{
  for (i = 0; i < message_count; i++)
  {
    if (message_sprites[i].text == text)
      message_sprites[i] = NULL;
  }
}
Plymouth.SetHideMessageFunction(on_hide_message);
