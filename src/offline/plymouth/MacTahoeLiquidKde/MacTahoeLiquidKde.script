# MacTahoe Liquid KDE — Plymouth boot splash
#
# Black background with a centered logo, scaled to ~7% of the
# screen's smaller dimension. 4K screen → ~150px logo. Matches
# macOS Tahoe's actual boot-time logo proportions. On multi-monitor setups Plymouth's
# renderer mirrors the script's output to every connected display,
# so a single Sprite at the geometric centre lands centred on each
# screen automatically — DO NOT iterate Window.GetCount() and build
# per-monitor sprite arrays; the DRM renderer at real boot time
# treats those differently than the X11 plugin and ships black.
#
# Mode handling:
#   We honour Plymouth.GetMode(). Boot mode shows a thin progress
#   bar under the logo; shutdown / reboot share the same logo
#   position with the bar hidden, so the logo lands on the same
#   pixel across every mode.
#
# Plymouth callbacks we wire:
#   - SetQuitFunction          keep the logo at full opacity through
#                              handoff to the DE so we never flash a
#                              partial image during the final frame.
#   - SetBootProgressFunction  grows the white fill across the track
#                              as progress goes 0 → 1. Bound on boot
#                              only.
#   - SetDisplayMessage*       fsck warnings / LUKS hints / recovery
#                              text get stacked in the top-left.

# ── background ──────────────────────────────────────────────────────────

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# ── assets + mode ───────────────────────────────────────────────────────

mode          = Plymouth.GetMode();
show_progress = (mode == "boot");

logo_source  = Image("boot.png");
track_source = Image("progress_track.png");
fill_source  = Image("progress_fill.png");

logo         = Sprite();
track_sprite = Sprite();
fill_sprite  = Sprite();

# Plymouth can start on a firmware/simpledrm framebuffer and then replace it
# with the native DRM mode. The old one-shot geometry made the splash visibly
# shrink and jump when that handoff changed Window.GetWidth()/GetHeight(). Keep
# the expensive image scaling cached, but recompute it whenever the renderer's
# geometry changes.
layout_x = -1;
layout_y = -1;
layout_w = -1;
layout_h = -1;
current_progress = 0;
pw_sprite = NULL;
pw_image = NULL;

fun update_layout()
{
  next_x = Window.GetX();
  next_y = Window.GetY();
  next_w = Window.GetWidth();
  next_h = Window.GetHeight();

  if (next_w < 1 || next_h < 1)
    return;
  if (next_x == layout_x && next_y == layout_y &&
      next_w == layout_w && next_h == layout_h)
    return;

  layout_x = next_x;
  layout_y = next_y;
  layout_w = next_w;
  layout_h = next_h;
  screen_w = next_w;
  screen_h = next_h;

  # Logo: 7% of the smaller axis, centred.
  if (screen_w < screen_h)
    logo_target = Math.Int(screen_w * 0.07);
  else
    logo_target = Math.Int(screen_h * 0.07);

  logo_image = logo_source.Scale(logo_target, logo_target);
  logo.SetImage(logo_image);
  logo.SetX(layout_x + screen_w / 2 - logo_image.GetWidth()  / 2);
  logo.SetY(layout_y + screen_h / 2 - logo_image.GetHeight() / 2);
  logo.SetOpacity(1);

  # Progress bar: 7.2% of screen width, just below the logo (boot only).
  bar_w = Math.Int(screen_w * 0.072);
  bar_h = Math.Int(bar_w * 0.02);
  if (bar_h < 4)
    bar_h = 4;
  bar_x = layout_x + screen_w / 2 - bar_w / 2;
  bar_y = logo.GetY() + logo_image.GetHeight() + Math.Int(screen_h * 0.035);

  track_image = track_source.Scale(bar_w, bar_h);
  track_sprite.SetImage(track_image);
  track_sprite.SetX(bar_x);
  track_sprite.SetY(bar_y);
  if (!show_progress)
    track_sprite.SetOpacity(0);
  else
    track_sprite.SetOpacity(1);

  fill_sprite.SetX(bar_x);
  fill_sprite.SetY(bar_y);
  if (show_progress && current_progress > 0)
  {
    fill_image = fill_source.Scale(Math.Int(bar_w * current_progress), bar_h);
    fill_sprite.SetImage(fill_image);
    fill_sprite.SetOpacity(1);
  }
  else
    fill_sprite.SetOpacity(0);

  if (pw_sprite && pw_image)
  {
    pw_sprite.SetX(layout_x + screen_w / 2 - pw_image.GetWidth() / 2);
    pw_sprite.SetY(logo.GetY() + logo_image.GetHeight() + Math.Int(screen_h * 0.10));
  }
}

update_layout();

fun on_refresh()
{
  update_layout();
}
Plymouth.SetRefreshFunction(on_refresh);

# ── callbacks ───────────────────────────────────────────────────────────

fun on_quit()
{
  logo.SetOpacity(1);
}
Plymouth.SetQuitFunction(on_quit);

fun on_boot_progress(duration, progress)
{
  if (progress < 0)
    progress = 0;
  if (progress > 1)
    progress = 1;
  current_progress = progress;
  fill_image = fill_source.Scale(Math.Int(bar_w * progress), bar_h);
  fill_sprite.SetImage(fill_image);
  fill_sprite.SetOpacity(1);
}
if (show_progress)
  Plymouth.SetBootProgressFunction(on_boot_progress);

# Console-style messages from the boot process get stacked in the
# top-left so a stalled boot is still diagnosable without exiting
# the splash. White text, transparent background, 10px insets.

message_y       = 10;
message_sprites = [];
message_count   = 0;

fun on_show_message(text)
{
  rendered = Image.Text(text, 1, 1, 1);
  sprite   = Sprite(rendered);
  sprite.SetPosition(10, message_y, 10000);
  sprite.text = text;
  message_sprites[message_count] = sprite;
  message_count++;
  message_y += rendered.GetHeight();
}
Plymouth.SetDisplayMessageFunction(on_show_message);

fun on_hide_message(text)
{
  for (i = 0; i < message_count; i++)
  {
    if (message_sprites[i].text == text)
      message_sprites[i] = NULL;
  }
}
Plymouth.SetHideMessageFunction(on_hide_message);

# ── password prompt (LUKS2 / cryptsetup) ─────────────────────────────
# Without this callback the script plugin draws nothing and the LUKS2
# passphrase is typed blind (issue #48). Called on every keystroke;
# `bullets` is the mask length — the typed text is never passed.

fun on_password(prompt, bullets)
{
  if (!prompt)
    prompt = "Password:";
  mask = "";
  for (i = 0; i < bullets; i++)
    mask = mask + "*";
  pw_image = Image.Text(prompt + " " + mask, 1, 1, 1);
  if (pw_sprite == NULL)
    pw_sprite = Sprite(pw_image);
  pw_sprite.SetImage(pw_image);
  pw_sprite.SetOpacity(1);
  pw_sprite.SetX(layout_x + screen_w / 2 - pw_image.GetWidth() / 2);
  pw_sprite.SetY(logo.GetY() + logo_image.GetHeight() + Math.Int(screen_h * 0.10));
  pw_sprite.SetZ(10000);
}
Plymouth.SetDisplayPasswordFunction(on_password);

# Boot resumed (passphrase accepted) — hide the prompt so it doesn't
# stay painted through the rest of boot and the SDDM handoff.
fun on_normal()
{
  if (pw_sprite)
    pw_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(on_normal);
