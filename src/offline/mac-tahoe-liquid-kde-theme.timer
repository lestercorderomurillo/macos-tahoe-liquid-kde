[Unit]
Description=MacTahoe Liquid KDE — fire time-based light/dark transitions
PartOf=graphical-session.target

[Timer]
# Fire at 06:00 (light) and 18:00 (dark) every day.
# Persistent=true catches missed firings when:
#   * PC was off at 06:00 and boots at 10:00 → light applies at boot
#   * Suspend crossed 18:00 → dark applies on resume
#   * Session starts between transitions → last transition re-fires
# Combined with watch service's sync_auto_mode_on_startup, late logins are
# always reconciled.
OnCalendar=*-*-* 06:00:00
OnCalendar=*-*-* 18:00:00
Persistent=true
Unit=mac-tahoe-liquid-kde-theme-apply.service

[Install]
WantedBy=graphical-session.target
