# openSUSE Tumbleweed — /usr/lib64/qt6, zypper-flavoured package names.
#
# Dep groups (do NOT inline `#` comments inside the `\`-continued arg
# list — bash treats `#` mid-command as a line comment and silently
# drops every arg after it; missing KF6 / Plasma cmake configs then
# surface only at the cmake configure step, not at the zypper install
# probe):
#   - base toolchain: python3, pytest, cmake, make, gcc-c++, ECM, pkgconf
#   - Qt6: base, tools, uitools (acrylic-glass effect's find_package),
#     declarative
#   - KF6 frameworks for deps() of the compiled steps
#   - Plasma / KSysGuard / plasma-workspace cmake configs
#   - KWin + KDecoration (acrylic-glass kwin effect)
#   - libepoxy + libdrm + libX11 + libxcb (acrylic-glass effect)
FROM opensuse/tumbleweed:latest

# `zypper refresh` against download.opensuse.org occasionally times out
# from GitHub runners (curl error 28 after the 180s default). Retry up
# to 3 times before giving up — every individual refresh is a clean
# operation, and the cost of a redundant 5s refresh on a healthy mirror
# is negligible compared to a flaky-mirror CI failure.
#
# Tumbleweed is rolling: the `:latest` base image lags the live mirror,
# so a plain install can resolve a package version whose RPM the mirror
# has already rotated away (404). `zypper dup` first aligns the base
# image to the current snapshot so installs only ever request packages
# that still exist on the mirror.
RUN for i in 1 2 3; do \
        zypper --non-interactive refresh && break; \
        echo "zypper refresh attempt $i failed; retrying"; \
        sleep 5; \
    done && \
    zypper --non-interactive --gpg-auto-import-keys dup --no-recommends && \
    zypper --non-interactive install --no-recommends \
        python3 python3-pytest \
        cmake make gcc-c++ kf6-extra-cmake-modules pkgconf-pkg-config \
        qt6-base-devel qt6-tools-devel qt6-uitools-devel \
        qt6-declarative-devel \
        kf6-kconfig-devel kf6-kconfigwidgets-devel kf6-kcoreaddons-devel \
        kf6-kcrash-devel kf6-kglobalaccel-devel kf6-kguiaddons-devel \
        kf6-ki18n-devel kf6-kio-devel kf6-kcmutils-devel \
        kf6-knotifications-devel kf6-kservice-devel \
        kf6-kwidgetsaddons-devel kf6-kwindowsystem-devel \
        kf6-kitemmodels-devel \
        libplasma6-devel plasma6-activities-devel \
        plasma6-activities-stats-devel libksysguard6-devel \
        plasma6-workspace-devel \
        kwin6-devel kdecoration6-devel \
        libepoxy-devel libdrm-devel libX11-devel libxcb-devel \
    && zypper clean --all

WORKDIR /repo
COPY . /repo

CMD ["python3", "tests/containers/run_in_container.py"]
