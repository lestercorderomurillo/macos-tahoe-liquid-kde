# KDE neon User Edition — Ubuntu LTS base with KDE's current released
# Frameworks and Plasma packages. Use KDE's maintained registry image;
# the old Docker Hub kdeneon/plasma image stopped updating years ago.
FROM invent-registry.kde.org/neon/docker-images/plasma:user

USER root

ENV PYTHONUNBUFFERED=1

# Build dependencies for every compiled installer component. Runtime-only
# dependencies are still checked by run_in_container.py with `apt show`, so
# a bad distro.py mapping fails even when that package is not needed to
# configure CMake in this stripped-down container.
#
# Noble's qt5-style-kvantum does not ship a Qt 6 style plugin. The installer
# therefore builds the pinned, bundled Qt 6 engine instead of adding a PPA.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-pytest \
        cmake make g++ extra-cmake-modules pkgconf \
        qmake6 qdbus-qt6 \
        qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-tools-dev \
        qt6-svg-dev \
        libkf6config-bin libkf6config-dev libkf6configwidgets-dev \
        libkf6coreaddons-dev libkf6crash-dev libkf6globalaccel-dev \
        libkf6guiaddons-dev libkf6i18n-dev libkf6itemmodels-dev \
        libkf6kcmutils-dev libkf6kio-dev libkf6notifications-dev \
        libkf6service-dev libkf6widgetsaddons-dev libkf6windowsystem-dev \
        libplasma-dev plasma-activities-dev plasma-activities-stats-dev \
        libksysguard-dev plasma-workspace-dev \
        kwin-dev libkdecorations3-dev \
        libepoxy-dev libdrm-dev libwayland-dev libx11-dev libxext-dev \
        libxcb1-dev \
        libvulkan-dev zstd && \
    apt-get clean

WORKDIR /repo
COPY . /repo

CMD ["python3", "tests/containers/run_in_container.py"]
