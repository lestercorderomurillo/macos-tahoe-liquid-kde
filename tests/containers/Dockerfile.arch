# Arch Linux — pacman ecosystem. CachyOS / Manjaro share this libdir
# layout, so a pass here covers all three.
FROM archlinux:latest

RUN pacman -Syu --noconfirm --needed \
    python python-pytest \
    qt6-base qt6-tools \
    pkgconf \
    && pacman -Scc --noconfirm

WORKDIR /repo
COPY . /repo

# Smoke-check the distro layer, then run the test suite. The full
# installer needs plasmashell + KWin running so we don't execute it
# here; the static + path-discovery tests are what prove a v0.15.0
# install on this distro will land .so / QML under the right libdir.
CMD ["python3", "tests/containers/run_in_container.py"]
