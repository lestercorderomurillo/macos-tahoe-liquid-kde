# Garuda Linux — Arch-derived with Chaotic-AUR enabled and a custom
# performance-tuned kernel. Same /usr/lib/qt6 layout. Garuda also has
# no first-party Docker image, so we synthesise /etc/os-release on top
# of the Arch base.
FROM archlinux:latest

RUN printf 'NAME="Garuda Linux"\nID=garuda\nID_LIKE=arch\nPRETTY_NAME="Garuda Linux"\n' > /etc/os-release

RUN pacman -Sy --noconfirm --needed \
    python python-pytest \
    qt6-base qt6-tools \
    pkgconf \
    && pacman -Scc --noconfirm

WORKDIR /repo
COPY . /repo

CMD ["python3", "tests/containers/run_in_container.py"]
