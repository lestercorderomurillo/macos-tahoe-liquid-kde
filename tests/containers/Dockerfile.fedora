# Fedora — uses /usr/lib64/qt6 like Gentoo, but reaches it via dnf
# (different package name from Gentoo, different os-release id).
FROM fedora:latest

RUN dnf install -y --setopt=install_weak_deps=False \
        python3 python3-pytest \
        qt6-qtbase qt6-qttools-devel \
        pkgconf-pkg-config \
    && dnf clean all

WORKDIR /repo
COPY . /repo

CMD ["python3", "tests/containers/run_in_container.py"]
