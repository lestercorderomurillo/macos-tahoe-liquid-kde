# Fedora — uses /usr/lib64/qt6 like Gentoo, but reaches it via dnf
# (different package name from Gentoo, different os-release id).
FROM fedora:latest

# Dep groups (do NOT inline comments inside the `\`-continued arg list
# — bash treats `#` mid-command as a line comment and silently drops
# every arg after it; missing KF6 / Plasma cmake configs then surface
# only at the cmake configure step, not at the dnf install probe):
#   - base toolchain: python3, pytest, cmake, make, gcc-c++, ECM, pkgconf
#   - Qt6: qtbase, qttools, qtdeclarative
#   - KF6 frameworks for deps() of the compiled steps
#   - Plasma / KSysGuard / plasma-workspace cmake configs
#   - KWin + KDecoration (acrylic-glass kwin effect)
#   - libepoxy + libdrm + libX11 + libxcb (acrylic-glass effect)
RUN dnf install -y --setopt=install_weak_deps=False \
        python3 python3-pytest \
        cmake make gcc-c++ extra-cmake-modules pkgconf-pkg-config \
        qt6-qtbase-devel qt6-qttools-devel qt6-qtdeclarative-devel \
        kf6-kconfig-devel kf6-kconfigwidgets-devel kf6-kcoreaddons-devel \
        kf6-kcrash-devel kf6-kglobalaccel-devel kf6-kguiaddons-devel \
        kf6-ki18n-devel kf6-kio-devel kf6-kcmutils-devel \
        kf6-knotifications-devel kf6-kservice-devel \
        kf6-kwidgetsaddons-devel kf6-kwindowsystem-devel \
        kf6-kitemmodels-devel \
        libplasma-devel plasma-activities-devel \
        plasma-activities-stats-devel libksysguard-devel \
        plasma-workspace-devel \
        kwin-devel kdecoration-devel \
        libepoxy-devel libdrm-devel libX11-devel libxcb-devel \
    && dnf clean all

WORKDIR /repo
COPY . /repo

CMD ["python3", "tests/containers/run_in_container.py"]
