# Bazzite — Fedora Atomic gaming spin (rpm-ostree based). Same
# /usr/lib64/qt6 layout. The atomic root is immutable in production
# but for the CI path-discovery test we only need the right libdir
# convention + dnf availability, so we piggyback on the Fedora base.
FROM fedora:latest

RUN printf 'NAME="Bazzite"\nID=bazzite\nID_LIKE=fedora\nPRETTY_NAME="Bazzite"\n' > /etc/os-release

RUN dnf install -y --setopt=install_weak_deps=False \
        python3 python3-pytest \
        qt6-qtbase qt6-qttools-devel \
        pkgconf-pkg-config \
    && dnf clean all

WORKDIR /repo
COPY . /repo

CMD ["python3", "tests/containers/run_in_container.py"]
