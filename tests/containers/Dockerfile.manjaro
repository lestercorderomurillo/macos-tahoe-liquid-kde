# Manjaro — Arch-derived but with its own stable/testing channels and
# slightly older package set. Same /usr/lib/qt6 libdir, same pacman.
FROM manjarolinux/base:latest

# The stable image's libimagequant signer needs its expiry extension from WKD.
# Keep normal pacman signature verification and the subsequent full upgrade.
RUN gpg --homedir "$(pacman-conf GPGDir)" --auto-key-locate clear,nodefault,wkd \
        --locate-external-keys mtorromeo@archlinux.org && \
    pacman -Sy --noconfirm --needed archlinux-keyring manjaro-keyring && \
    pacman -Syu --noconfirm --needed \
    python python-pytest git zstd python-pillow python-pyqt6 plasma5support librsvg \
    cmake make gcc extra-cmake-modules \
    qt6-base qt6-tools qt6-declarative qt6-svg \
    pkgconf \
    kconfig kconfigwidgets kcoreaddons kcrash kglobalaccel kguiaddons \
    ki18n kio kcmutils knotifications kservice kwidgetsaddons \
    kwindowsystem kitemmodels \
    libplasma plasma-activities plasma-activities-stats libksysguard \
    plasma-workspace \
    kwin kdecoration vulkan-headers \
    libepoxy libx11 libxcb \
    && pacman -Scc --noconfirm

WORKDIR /repo
COPY . /repo

CMD ["python3", "tests/containers/run_in_container.py"]
