# Gentoo CI container. FROMs a pre-built base image that already has
# Qt6 emerged + binhost configured, so the test runs in seconds instead
# of waiting for a 25-min source build of qtbase whenever the Gentoo
# binhost lags upstream Qt6.
#
# The base image is built (and refreshed monthly) by
# .github/workflows/build-gentoo-base.yml and lives on GHCR. Bump it
# manually from the Actions UI when you need to re-verify against a
# newer Qt6 release.
#
# For LOCAL runs, ./tests/containers/run_matrix.sh gentoo will pull the
# same image from GHCR — no source compile.

FROM ghcr.io/lestercorderomurillo/mttkde-gentoo-base:latest

WORKDIR /repo
COPY . /repo

CMD ["python3", "tests/containers/run_in_container.py"]
