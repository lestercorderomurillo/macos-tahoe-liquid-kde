# CachyOS — the maintainer's daily-driver. Arch-derived, same
# /usr/lib/qt6 libdir, same pacman package names. Existing Arch
# coverage already exercises this in practice, but a dedicated row
# makes the CI matrix reflect the README claim.
FROM cachyos/cachyos:latest

# Base image ships pacman keyrings that drift out of date — pacman -Sy
# then fails with ``signature from "CachyOS <admin@cachyos.org>" is
# invalid``. Refresh the keyring before any sync so the rest of the
# build is on current keys. Both keyrings are required (archlinux-
# keyring for core/extra/multilib repos, cachyos-keyring for the
# cachyos overlay).
RUN pacman-key --init && \
    pacman-key --populate archlinux cachyos && \
    pacman -Sy --noconfirm archlinux-keyring cachyos-keyring && \
    pacman -Sy --noconfirm --needed \
        python python-pytest \
        cmake make gcc extra-cmake-modules \
        qt6-base qt6-tools qt6-declarative \
        pkgconf \
        kconfig kconfigwidgets kcoreaddons kcrash kglobalaccel kguiaddons \
        ki18n kio kcmutils knotifications kservice kwidgetsaddons \
        kwindowsystem \
        libplasma plasma-activities plasma-activities-stats libksysguard \
        plasma-workspace \
        kwin kdecoration \
        libepoxy libx11 libxcb \
    && pacman -Scc --noconfirm

WORKDIR /repo
COPY . /repo

CMD ["python3", "tests/containers/run_in_container.py"]
